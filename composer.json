{
    "name": "tinywan/harness",
    "description": "A PHP library for driving AI coding CLIs (Claude Code, Codex, GitHub Copilot CLI, OpenCode) in headless mode.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tinywan",
            "email": "756684177@qq.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/process": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Harness\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Harness\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php ./vendor/pestphp/pest/bin/pest",
        "test:docker": "docker exec -w /var/www/ai/harness dnmp-php84 ./vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
